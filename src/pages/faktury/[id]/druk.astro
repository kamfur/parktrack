---
export const prerender = false;

import { z } from "zod";
import { parkingTypeLabel } from "../../../lib/pricing/parking-type";
import { InvoiceService } from "../../../lib/services/invoice.service";

const { id } = Astro.params;

if (!id || !z.string().uuid().safeParse(id).success) {
  return Astro.redirect("/");
}

const supabase = Astro.locals.supabase;

const invoice = await new InvoiceService(supabase).getById(id);

if (!invoice) {
  return new Response("Faktura nie znaleziona", { status: 404 });
}

// Legacy = issued before the VAT breakdown (vat_rate null): render exactly as it was printed then.
const isLegacy = invoice.vat_rate === null;
const isAgencyInvoice = invoice.travel_agency_id !== null;
const firstItem = invoice.items[0];

// Payment status only makes sense for a single individual reservation.
const { data: reservation } =
  !isAgencyInvoice && invoice.items.length === 1
    ? await supabase
        .from("reservations")
        .select("is_paid, planned_check_in, planned_check_out, parking_type")
        .eq("id", firstItem.reservation_id)
        .maybeSingle()
    : { data: null };

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("pl-PL", { day: "2-digit", month: "2-digit", year: "numeric" });

const formatWarsawDate = (iso: string) =>
  new Date(iso).toLocaleDateString("pl-PL", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    timeZone: "Europe/Warsaw",
  });

/** `YYYY-MM-DD` (SQL date) → `DD.MM.YYYY` without timezone shifts. */
const formatDateOnly = (value: string | null) => {
  if (!value) return "—";
  const [y, m, d] = value.split("-");
  return `${d}.${m}.${y}`;
};

const formatCurrency = (amount: number) =>
  amount.toLocaleString("pl-PL", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " PLN";

const formatDays = (days: number) => `${days} ${days === 1 ? "dzień" : "dni"}`;

const createdDate = formatDate(invoice.created_at);
const checkInDate = reservation ? formatDate(reservation.planned_check_in) : "—";
const checkOutDate = reservation ? formatDate(reservation.planned_check_out) : "—";
const isPaid = reservation?.is_paid ?? false;
const parkingLabel = parkingTypeLabel(reservation?.parking_type);
// Price lists price the whole stay (not a per-day rate), so the invoice line is one service at the total.
const daysLabel = formatDays(firstItem?.days_count ?? 1);

const billingPeriodLabel =
  invoice.billing_year && invoice.billing_month
    ? new Date(Date.UTC(invoice.billing_year, invoice.billing_month - 1, 15)).toLocaleDateString("pl-PL", {
        month: "long",
        year: "numeric",
        timeZone: "UTC",
      })
    : null;

const itemLabel = (item: (typeof invoice.items)[number]) => {
  const period = `${formatWarsawDate(item.period_start)} – ${formatWarsawDate(item.period_end)}`;
  const base = `${item.description} (${parkingTypeLabel(item.parking_type)}, ${formatDays(item.days_count)}) – ${period}`;
  if (!isAgencyInvoice) return base;
  const plate = item.license_plate ? `, ${item.license_plate}` : "";
  return `${base} – ${item.guest_name}${plate}`;
};

const vatRateLabel = `${Number(invoice.vat_rate ?? 0).toLocaleString("pl-PL")}%`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Faktura {invoice.invoice_number} - ParkTrack</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        color: #111;
        background: #f5f5f5;
      }
      .page {
        max-width: 800px;
        margin: 0 auto;
        background: #fff;
        padding: 40px;
      }
      .no-print-bar {
        background: #1e293b;
        color: #fff;
        padding: 12px 24px;
        display: flex;
        gap: 16px;
        align-items: center;
      }
      .no-print-bar a {
        color: #93c5fd;
        text-decoration: none;
        font-size: 13px;
      }
      .no-print-bar button {
        background: #3b82f6;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
      }
      .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
      }
      .invoice-title {
        font-size: 24px;
        font-weight: bold;
      }
      .invoice-meta {
        text-align: right;
        font-size: 13px;
        color: #555;
      }
      .invoice-meta .number {
        font-size: 18px;
        font-weight: bold;
        color: #111;
      }
      .parties {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
      }
      .party {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
      }
      .party h3 {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        margin-bottom: 10px;
      }
      .party p {
        font-size: 14px;
        line-height: 1.6;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 24px;
      }
      th {
        background: #f3f4f6;
        text-align: left;
        padding: 10px 12px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        border-bottom: 2px solid #e5e7eb;
      }
      td {
        padding: 12px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
      }
      .total-row {
        background: #f9fafb;
      }
      .total-row td {
        font-weight: bold;
        font-size: 15px;
      }
      td.num {
        text-align: right;
        white-space: nowrap;
      }
      .summary {
        margin-top: 8px;
        font-size: 14px;
        line-height: 1.8;
      }
      .payment-status {
        margin-top: 24px;
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
      }
      .paid {
        background: #dcfce7;
        color: #166534;
      }
      .unpaid {
        background: #fef9c3;
        color: #854d0e;
      }

      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: #fff;
          font-size: 12pt;
        }
        .page {
          padding: 0;
          max-width: none;
        }
        .party {
          break-inside: avoid;
        }
        table {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <div class="no-print no-print-bar">
      <button onclick="window.print()">Drukuj</button>
      <a href={`/faktury`}>← Wróć do listy</a>
    </div>

    <div class="page">
      <div class="invoice-header">
        <div class="invoice-title">FAKTURA VAT</div>
        <div class="invoice-meta">
          <div class="number">{invoice.invoice_number}</div>
          {
            isLegacy ? (
              <div>Wystawiono: {createdDate}</div>
            ) : (
              <>
                <div>Data wystawienia: {formatDateOnly(invoice.issue_date)}</div>
                <div>Data sprzedaży: {formatDateOnly(invoice.sale_date)}</div>
                {billingPeriodLabel && <div>Okres rozliczeniowy: {billingPeriodLabel}</div>}
              </>
            )
          }
        </div>
      </div>

      <div class="parties">
        <div class="party">
          <h3>Sprzedawca</h3>
          <p>
            <strong>{invoice.seller_name}</strong><br />
            {invoice.seller_address}<br />
            NIP: {invoice.seller_nip}<br />
            Konto: {invoice.seller_bank_account}
          </p>
        </div>
        <div class="party">
          <h3>Nabywca</h3>
          <p>
            <strong>{invoice.buyer_name}</strong><br />
            {invoice.buyer_address}<br />
            NIP: {invoice.buyer_nip}
            {
              invoice.buyer_email && (
                <>
                  <br />
                  {invoice.buyer_email}
                </>
              )
            }
          </p>
        </div>
      </div>

      {
        isLegacy ? (
          <table>
            <thead>
              <tr>
                <th>Lp</th>
                <th>Nazwa usługi</th>
                <th>Ilość</th>
                <th>J.m.</th>
                <th>Cena jedn.</th>
                <th>Wartość</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1</td>
                <td>
                  Usługa parkingowa ({parkingLabel}, {daysLabel}) – {checkInDate} – {checkOutDate}
                </td>
                <td>1</td>
                <td>usł.</td>
                <td>{formatCurrency(invoice.total_amount)}</td>
                <td>{formatCurrency(invoice.total_amount)}</td>
              </tr>
              <tr class="total-row">
                <td colspan="5" style="text-align: right;">
                  Razem:
                </td>
                <td>{formatCurrency(invoice.total_amount)}</td>
              </tr>
            </tbody>
          </table>
        ) : (
          <table>
            <thead>
              <tr>
                <th>Lp</th>
                <th>Nazwa usługi</th>
                <th>Ilość</th>
                <th>J.m.</th>
                <th>Wartość netto</th>
                <th>VAT</th>
                <th>Kwota VAT</th>
                <th>Wartość brutto</th>
              </tr>
            </thead>
            <tbody>
              {invoice.items.map((item) => (
                <tr>
                  <td>{item.position}</td>
                  <td>{itemLabel(item)}</td>
                  <td>1</td>
                  <td>usł.</td>
                  <td class="num">{formatCurrency(item.net_amount ?? 0)}</td>
                  <td class="num">{vatRateLabel}</td>
                  <td class="num">{formatCurrency(item.vat_amount ?? 0)}</td>
                  <td class="num">{formatCurrency(item.gross_amount)}</td>
                </tr>
              ))}
              <tr class="total-row">
                <td colspan="4" style="text-align: right;">
                  Razem:
                </td>
                <td class="num">{formatCurrency(invoice.total_net ?? 0)}</td>
                <td class="num">{vatRateLabel}</td>
                <td class="num">{formatCurrency(invoice.total_vat ?? 0)}</td>
                <td class="num">{formatCurrency(invoice.total_amount)}</td>
              </tr>
            </tbody>
          </table>
        )
      }

      {
        !isLegacy && (
          <div class="summary">
            <div>
              Do zapłaty: <strong>{formatCurrency(invoice.total_amount)}</strong>
            </div>
            {invoice.payment_due_date && (
              <div>
                Termin płatności: {formatDateOnly(invoice.payment_due_date)} (przelew na konto:{" "}
                {invoice.seller_bank_account})
              </div>
            )}
          </div>
        )
      }

      {
        !isAgencyInvoice && (
          <div class={`payment-status ${isPaid ? "paid" : "unpaid"}`}>{isPaid ? "Opłacono" : "Oczekuje na płatność"}</div>
        )
      }
    </div>
  </body>
</html>
