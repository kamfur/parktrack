# Supabase (required for dev / E2E)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E2E auth (Playwright setup — real Supabase user)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Optional. Defaults to the official KTW public arrivals list used by the flight board.
# KTW_ARRIVALS_URL=https://www.katowice-airport.com/pl/api/flight-board/list

# Voice reservations PoC (scripts/soniox-poc) — https://console.soniox.com (EU project)
# SONIOX_API_KEY=
# SONIOX_REGION=eu

# M5L2 AI code reviewer (packages/code-reviewer) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
