# Supabase (required for dev / E2E)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E2E auth (Playwright setup — real Supabase user)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Optional. Defaults to the official KTW public arrivals list used by the flight board.
# KTW_ARRIVALS_URL=https://www.katowice-airport.com/pl/api/flight-board/list

# Voice reservations — https://console.soniox.com. Use a key from an EU-region project
# (SONIOX_REGION must match the project region: eu | us). Also used by scripts/soniox-poc.
# SONIOX_API_KEY=
# SONIOX_REGION=eu
# Show the "Dyktuj" button in reservation forms.
# PUBLIC_VOICE_ENABLED=true

# M5L2 AI code reviewer (packages/code-reviewer) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.1
