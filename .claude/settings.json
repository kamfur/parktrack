{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-lint.mjs",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-typecheck.mjs",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
