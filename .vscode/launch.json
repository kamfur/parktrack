{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Astro Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect-brk=9229", "./node_modules/astro/astro.js", "dev"],
      "port": 9229,
      "serverReadyAction": {
        "pattern": "Local:.*https?://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Attach to Astro Dev Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    },
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Development server (no debug)",
      "request": "launch",
      "type": "node-terminal"
    }
  ]
}
